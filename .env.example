# Database Configuration (SQLite file for local persistence, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="vestly_super_secure_jwt_secret_key_change_in_production_32chars"
NEXTAUTH_SECRET="vestly_nextauth_secret_key_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Market & News APIs (Server-side only)
# Finnhub API: Primary data provider for quotes, indices, company profiles, and market news.
# Free tier: 60 calls/min. Sign up at https://finnhub.io/
FINNHUB_API_KEY=""

# Alpha Vantage API: Secondary/supplementary data provider.
# Free tier: 25 requests/day. Sign up at https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=""

# Optional: Google OAuth (if configuring Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
